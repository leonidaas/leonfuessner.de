#!/usr/bin/env ruby
# frozen_string_literal: true

# Start a post with as little friction as possible.
#
#     ruby script/new-post Title of the post
#
# Works from any working directory — paths are resolved from this file.
# Writes _posts/YYYY-MM-DD-slug.md with title + today's date, empty
# description and tags, prints the path, then tries to open it in the
# publishing vault via obsidian:// (so it works even if you are currently
# in the Sync vault). Stdlib only.
#
# Unpushed = draft. See WRITING.md.

require "date"
require "fileutils"
require "uri"

title = ARGV.join(" ").strip
if title.empty?
  warn "usage: ruby script/new-post Title of the post"
  exit 1
end

slug = title.downcase
begin
  slug = slug.unicode_normalize(:nfkd).gsub(/\p{Mn}/, "")
rescue ArgumentError
  # encoding already ascii-ish
end
slug = slug.gsub(/[^a-z0-9]+/, "-").gsub(/\A-+|-+\z/, "")

if slug.empty?
  warn "could not slugify #{title.inspect}"
  exit 1
end

date = Date.today
filename = "#{date.strftime('%Y-%m-%d')}-#{slug}.md"
root = File.expand_path("..", __dir__)
posts = File.join(root, "_posts")
FileUtils.mkdir_p(posts)
path = File.join(posts, filename)

if File.exist?(path)
  warn "already exists: #{path}"
  exit 1
end

quoted = '"' + title.gsub("\\", "\\\\").gsub('"', '\\"') + '"'

File.write(path, <<~MD)
  ---
  title: #{quoted}
  date: #{date.strftime('%Y-%m-%d')}
  description: ""
  tags: []
  ---

MD

puts path

# Open in the publishing vault, even if the frontmost vault is the private
# Sync one. The vault name is this folder's name (leonfuessner.de) unless it
# was renamed in Obsidian's vault switcher — if the URI does nothing, the
# printed `open` line is the hint, not a failure.
vault = File.basename(root)
rel = "_posts/#{filename.sub(/\.md\z/, '')}"
enc = lambda { |s| URI.encode_www_form_component(s).gsub("+", "%20") }
uri = "obsidian://open?vault=#{enc.call(vault)}&file=#{enc.call(rel)}"

opened = RUBY_PLATFORM.include?("darwin") && system("open", uri)
warn %(open in the publishing vault: open "#{uri}") unless opened
